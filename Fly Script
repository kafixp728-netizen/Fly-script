--// Add fake message
local function addFakeMessage(username, message)
	if username == "" or message == "" then
		return
	end

	local messageFrame = Instance.new("Frame")
	messageFrame.Size = UDim2.new(1, -10, 0, 45)
	messageFrame.BackgroundTransparency = 1
	messageFrame.Parent = chatBox

	local text = Instance.new("TextLabel")
	text.Size = UDim2.new(1, -10, 1, 0)
	text.Position = UDim2.new(0, 5, 0, 0)
	text.BackgroundTransparency = 1
	text.Text = username .. ": " .. message
	text.TextColor3 = Color3.fromRGB(235,235,235)
	text.TextSize = 15
	text.Font = Enum.Font.Gotham
	text.TextXAlignment = Enum.TextXAlignment.Left
	text.TextWrapped = true
	text.Parent = messageFrame

	-- Scroll to bottom
	task.wait()
	chatBox.CanvasPosition = Vector2.new(
		0,
		math.max(0, chatBox.AbsoluteCanvasSize.Y)
	)
end

--// Send button
sendButton.MouseButton1Click:Connect(function()
	addFakeMessage(usernameBox.Text, messageBox.Text)
	messageBox.Text = ""
end)

--// Enter key sends message
messageBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		addFakeMessage(usernameBox.Text, messageBox.Text)
		messageBox.Text = ""
	end
end)
